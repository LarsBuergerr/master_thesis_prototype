                                   sh:path      skos:inScheme
                                 ]
                                 [ sh:hasValue  <http://dcat-ap.de/def/politicalGeocoding/stateKey>;
                                   sh:path      skos:inScheme
                                 ]
                               )
                     ];
        sh:path      dcatde:politicalGeocodingURI;
        sh:severity  sh:Warning .

