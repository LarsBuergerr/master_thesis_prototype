<http://purl.org/adms/assettype/Schema>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A schema is a concrete view on a system or information exchange, describing the structure, content, and semantics of data."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Schema";
        skos:prefLabel   "Schema"@en .

<http://purl.org/adms/assettype/DomainModel>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A domain model is a conceptual view of a system or an information exchange that identifies the entities involved and their relationships [NIEM Glossary ]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "DomainModel";
        skos:prefLabel   "Domain Model"@en .

<http://purl.org/adms/assettype/SyntaxEncodingScheme>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "Syntax Encoding Schemes indicate that the value is a string formatted in accordance with a formal notation, such as \"2000-01-01\" as the standard expression of a date. [DCMI Glossary]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "SyntaxEncodingScheme";
        skos:prefLabel   "Syntax Encoding Scheme"@en .

<http://purl.org/adms/assettype/CoreComponent>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A core component is a context-free semantic building block for creating clear and meaningful data models, vocabularies, and information exchange packages [UN/CEFACT CCTS ]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "CoreComponent";
        skos:prefLabel   "Core Component"@en .

<http://purl.org/adms/assettype/Mapping>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "relationship between a concept in one vocabulary and one or more concepts in another [ISO/DIS 25964-2]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Mapping";
        skos:prefLabel   "Mapping"@en .

<http://purl.org/adms/assettype/NameAuthorityList>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "controlled vocabulary for use in naming particular entities consistently [ISO/DIS 25964-2]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "NameAuthorityList";
        skos:prefLabel   "Name Authority List"@en .

<http://purl.org/adms/assettype/InformationExchangePackageDescription>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A collection of artifacts that define and describe the structure and content of an information exchange  [NIEM Glossary]. An Information Exchange Package Description has a specific information exchange context and may refer to other semantic assets."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "InformationExchangePackageDescription";
        skos:prefLabel   "Information Exchange Package Description"@en .

<http://purl.org/adms/assettype/ServiceDescription>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A service description is a set of documents that describe the interface to and semantics of a service [W3C WS-GLOSS ]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "ServiceDescription";
        skos:prefLabel   "Service Description"@en .

<http://purl.org/adms/assettype/Ontology>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A formal, explicit specification of a shared conceptualization [ISO/DIS 25964-2]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Ontology";
        skos:prefLabel   "Ontology"@en .

<http://purl.org/adms/assettype/Thesaurus>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "controlled and structured vocabulary in which concepts are represented by terms, organized so that relationships between concepts are made explicit, and preferred terms are accompanied by lead-in entries for synonyms or quasi-synonyms  [ISO 25964-1:2011]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Thesaurus";
        skos:prefLabel   "Thesaurus"@en .

<http://purl.org/adms/assettype/Taxonomy>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "scheme of categories and subcategories that can be used to sort and otherwise organize items of knowledge or information [ISO/DIS 25964-2]. "@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Taxonomy";
        skos:prefLabel   "Taxonomy"@en .

<http://purl.org/adms/assettype/CodeList>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "Complete set of data element values of a coded simple data element  [ISO 9735-1:2002, 4.14]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "CodeList";
        skos:prefLabel   "Code List"@en .

<http://purl.org/adms/assettype/1.0>
        rdf:type            owl:NamedIndividual , skos:ConceptScheme;
        rdfs:label          "Asset Type"@en;
        skos:hasTopConcept  <http://purl.org/adms/assettype/Schema> , <http://purl.org/adms/assettype/DomainModel> , <http://purl.org/adms/assettype/SyntaxEncodingScheme> , <http://purl.org/adms/assettype/CoreComponent> , <http://purl.org/adms/assettype/Mapping> , <http://purl.org/adms/assettype/NameAuthorityList> , <http://purl.org/adms/assettype/InformationExchangePackageDescription> , <http://purl.org/adms/assettype/ServiceDescription> , <http://purl.org/adms/assettype/Ontology> , <http://purl.org/adms/assettype/Thesaurus> , <http://purl.org/adms/assettype/Taxonomy> , <http://purl.org/adms/assettype/CodeList> .

