        sh:class     dcat:Dataset;
        sh:message   "dcat:DataService: dcat:servesDataset MUSS auf ein dcat:Dataset verweisen."@de;
        sh:path      dcat:servesDataset;
        sh:severity  sh:Violation .

dcatde:DataService_dct_license_v_IRI
        sh:message   "dcat:DataService: dct:license MUSS eine IRI sein."@de;
        sh:nodeKind  sh:IRI;
        sh:path      dcterms:license;
        sh:severity  sh:Violation .

<http://dcat-ap.de/def/licenses>
        rdf:type            owl:Ontology , skos:ConceptScheme;
        rdfs:comment        "Liste der Lizenzen, die im Feld dct:license einer DCAT-AP.de-konformen dcat:distribution für die Zulieferung an GovData erlaubt sind. GovData empfiehlt die Verwendung der Datenlizenz Deutschland 2.0 (Zero oder Namensnennung) sowie der Creative Commons Namensnennung – 4.0 International. Soweit dies nicht möglich sein sollte, wird die Verwendung einer der übrigen zur „freien Nutzung“ ausgewiesenen Lizenzen in der jeweils neuesten Version empfohlen."^^rdfs:Literal;
        rdfs:label          "Liste der Lizenzen"@de;
        dcterms:identifier  "http://www.dcat-ap.de/def/licenses";
        owl:versionIRI      <http://dcat-ap.de/def/licenses/20210721/>;
        owl:versionInfo     "20210721";
        skos:prefLabel      "Liste der Lizenzen"@de .

dcatde:DataService_dct_license_w_List
        sh:path      dcterms:license;
        sh:property  [ sh:hasValue  <http://dcat-ap.de/def/licenses>;
                       sh:message   "dcat:DataService: dct:license SOLL folgendes Vokabular benutzten: https://www.dcat-ap.de/def/licenses/"@de;
                       sh:path      skos:inScheme;
                       sh:severity  sh:Warning
                     ] .

skos:inScheme  rdf:type  owl:AnnotationProperty .

dcatde:DataService_dcatap_availability_v_List
        sh:path      <http://data.europa.eu/r5r#availability>;
        sh:property  [ sh:hasValue  <http://publications.europa.eu/resource/authority/planned-availability>;
                       sh:message   "dcat:DataService: dcatap:availability MUSS eine IRI aus diesem Vokabular verwenden: https://www.dcat-ap.de/def/dcatde/2.0/spec/#kv-availability"@de;
                       sh:path      skos:inScheme;
                       sh:severity  sh:Violation
                     ] .

dcatde:DataService_dcatap_availability_v_Max
        sh:maxCount  1;
        sh:message   "dcat:DataService: DARF maximal eine dcatap:availability haben."@de;
        sh:path      <http://data.europa.eu/r5r#availability>;
        sh:severity  sh:Violation .

dcatde:DataService_dcat_endpointURL_v_Min
        sh:message   "dcat:DataService: MUSS mindestens eine dcat:endpointURL haben."@de;
        sh:minCount  1;
        sh:path      dcat:endpointURL;
        sh:severity  sh:Violation .

dcatde:DataService_Shape
        rdf:type        sh:NodeShape;
        sh:name         "dcat:DataService gemäß DCAT-AP.de Spezifikation 2.0"@de;
        sh:property     dcatde:DataService_dcat_servesDataset_v_Class , dcatde:DataService_dct_license_v_IRI , dcatde:DataService_dct_license_w_List , dcatde:DataService_dcatap_availability_v_List , dcatde:DataService_dcatap_availability_v_Max , dcatde:DataService_dcat_endpointURL_v_Min;
        sh:targetClass  dcat:DataService .

<http://publications.europa.eu/resource/authority/planned-availability/EXPERIMENTAL>
        skos:inScheme      <http://publications.europa.eu/resource/authority/planned-availability>;
        skos:topConceptOf  <http://publications.europa.eu/resource/authority/planned-availability> .

