dcatde:KonvXX_dct_title_w_Min
        sh:message   "KXX: dcat:Distribution: dct:title: Es wird empfohlen, dass jede Distribution über einen dct:title verfügt."@de;
        sh:minCount  1;
        sh:path      dcterms:title;
        sh:severity  sh:Warning .

dcatde:Konv32_dct_format_v_List
        sh:path      dcterms:format;
        sh:property  [ sh:hasValue  <http://publications.europa.eu/resource/authority/file-type>;
                       sh:message   "K32: dcat:Distribution: dct:format MUSS eine IRI aus dem  EU Vokabular 'File Type' verwenden. Siehe: https://www.dcat-ap.de/def/dcatde/2.0/implRules/#konvention-32 "@de;
                       sh:path      skos:inScheme;
                       sh:severity  sh:Violation
                     ] .

dcatde:Konv31_dct_license_v_List
        sh:message              "K31: dcat:Distribution: dct:license MUSS eine IRI aus http://dcat-ap.de/def/licenses/ verwenden. Siehe: https://www.dcat-ap.de/def/dcatde/2.0/implRules/#konvention-31 "@de;
        sh:path                 dcterms:license;
        sh:qualifiedMinCount    1;
        sh:qualifiedValueShape  [ sh:hasValue  <http://dcat-ap.de/def/licenses>;
                                  sh:path      skos:inScheme
                                ];
        sh:severity             sh:Violation .

dcatde:Konv_Distribution_Shape
        rdf:type        sh:NodeShape;
        sh:name         "Konventionen zur dcat:Distribution gemäß DCAT-AP.de 2.0"@de;
        sh:property     dcatde:KonvXX_dct_title_w_Min , dcatde:Konv32_dct_format_v_List , dcatde:Konv31_dct_license_v_List;
        sh:targetClass  dcat:Distribution .

dc:date  rdf:type  owl:AnnotationProperty .

dcatde:Deprecated_dcat_Distribution_dcat_plannedAvailability
        sh:maxCount  0;
        sh:message   "Deprecated: dcat:Distribution: dcat:plannedAvailability soll nicht mehr verwendet werden. Stattdessen dcatap:availability. Siehe: https://www.dcat-ap.de/def/dcatde/2.0/spec/#distribution-verfugbarkeit "@de;
        sh:path      dcat:plannedAvailability;
        sh:severity  sh:Warning .

dcatde:Deprecated_dcat_Distribution_Shape
        rdf:type        sh:NodeShape;
        sh:name         "Deprecated Eigenschaften bei dcat:Distribution gemäß DCAT-AP.de 2.0"@de;
        sh:property     dcatde:Deprecated_dcat_Distribution_dcat_plannedAvailability;
        sh:targetClass  dcat:Distribution .

dcatde:Distribution_dcatde_plannedAvailability_v_IRI
        sh:message   "dcat:Distribution: dcatde:plannedAvailability MUSS eine IRI sein."@de;
        sh:nodeKind  sh:IRI;
        sh:path      dcatde:plannedAvailability;
        sh:severity  sh:Violation .

dcatde:Distribution_dct_license_v_IRI
        sh:message   "dcat:Distribution: dct:license MUSS eine IRI sein."@de;
        sh:nodeKind  sh:IRI;
        sh:path      dcterms:license;
        sh:severity  sh:Violation .

dcatde:Distribution_dct_language_v_List
        sh:path      dcterms:language;
        sh:property  [ sh:hasValue  <http://publications.europa.eu/resource/authority/language>;
                       sh:message   "dcat:Distribution: dct:language MUSS eine IRI aus diesem Vokabular verwenden: https://www.dcat-ap.de/def/dcatde/2.0/spec/#kv-languages"@de;
                       sh:path      skos:inScheme;
                       sh:severity  sh:Violation
                     ] .

dcatde:Distribution_dcat_accessService_v_Class
        sh:class     dcat:DataService;
        sh:message   "dcat:Distribution: dcat:accessService MUSS auf einen dcat:DataService verweisen."@de;
        sh:path      dcat:accessService;
        sh:severity  sh:Violation .

dcatde:Distribution_dct_format_v_List
        sh:path      dcterms:format;
        sh:property  [ sh:hasValue  <http://publications.europa.eu/resource/authority/file-type>;
                       sh:message   "dcat:Distribution: dct:format MUSS eine IRI aus diesem Vokabular verwenden: https://www.dcat-ap.de/def/dcatde/2.0/spec/#kv-file-type"@de;
                       sh:path      skos:inScheme;
                       sh:severity  sh:Violation
                     ] .

