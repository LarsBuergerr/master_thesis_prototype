org:location  rdf:type    rdf:Property , owl:DatatypeProperty;
        rdfs:comment      "例えば、内部配送目的のメール・ストップ（Mail Stop）などの、組織内の人の位置記述を提供します。"@ja , "Indica la descrizione del luogo presso cui è possibile reperire una persona dell'organizzazione."@it , "Indique la description de l'endroit ou est basé une personne de l'Organisation, par exemple pour des besoins de messagerie interne (Bureau 42)."@fr , "Lugar o ubicación exacta de una persona en una organización con el objetivo de facilitar, por ejemplo, la entrega de correo."@es , "Gives a location description for a person within the organization, for example a _Mail Stop_ for internal posting purposes."@en;
        rdfs:domain       foaf:Person;
        rdfs:isDefinedBy  <http://www.w3.org/ns/org>;
        rdfs:label        "está ubicado en"@es , "location"@en , "está ubicada en"@es , "luogo"@it , "localisation"@fr;
        rdfs:range        xsd:string .

