<http://purl.org/adms/assettype/Schema>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A schema is a concrete view on a system or information exchange, describing the structure, content, and semantics of data."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Schema";
        skos:prefLabel   "Schema"@en .

<http://purl.org/adms/assettype/DomainModel>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A domain model is a conceptual view of a system or an information exchange that identifies the entities involved and their relationships [NIEM Glossary ]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "DomainModel";
        skos:prefLabel   "Domain Model"@en .

<http://purl.org/adms/assettype/SyntaxEncodingScheme>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "Syntax Encoding Schemes indicate that the value is a string formatted in accordance with a formal notation, such as \"2000-01-01\" as the standard expression of a date. [DCMI Glossary]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "SyntaxEncodingScheme";
        skos:prefLabel   "Syntax Encoding Scheme"@en .

<http://purl.org/adms/assettype/CoreComponent>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "A core component is a context-free semantic building block for creating clear and meaningful data models, vocabularies, and information exchange packages [UN/CEFACT CCTS ]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "CoreComponent";
        skos:prefLabel   "Core Component"@en .

<http://purl.org/adms/assettype/Mapping>
        rdf:type         owl:NamedIndividual , skos:Concept;
        skos:definition  "relationship between a concept in one vocabulary and one or more concepts in another [ISO/DIS 25964-2]."@en;
        skos:inScheme    <http://purl.org/adms/assettype/1.0>;
        skos:notation    "Mapping";
        skos:prefLabel   "Mapping"@en .

