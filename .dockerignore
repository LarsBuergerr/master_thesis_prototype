.venv
__pycache__
**/__pycache__
*.pyc

# Heavy project data irrelevant to the web stack
data/
run_outputs/
ground_truth_outputs/
outputs/
thesis/
docs/
playground/
frontend/

# Runtime artifacts
backend/analyzer.db
backend/analyzer.db-shm
backend/analyzer.db-wal
.env
