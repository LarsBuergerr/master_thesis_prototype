  <owl:Ontology rdf:about="http://dcat-ap.de/def/politicalGeocoding/Level">
    <owl:versionInfo>1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="http://dcat-ap.de/def/politicalGeocoding/Level/1.0/"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">Zur kodierten Angabe der jeweiligen prinzipiellen Verwaltungsebene, von der die Datenstruktur erhoben und eingestellt wurde, sind folgende sechs Optionen mit Mehrfachauswahl möglich:</rdfs:comment>
  </owl:Ontology>
  <skos:ConceptScheme rdf:about="http://dcat-ap.de/def/politicalGeocoding/Level">
    <rdfs:label xml:lang="de">Liste der geopolitischen Verwaltungscodierung</rdfs:label>
    <skos:prefLabel xml:lang="de">Liste der geopolitischen Verwaltungscodierung</skos:prefLabel>
    <dct:identifier>http://www.dcat-ap.de/def/politicalGeocoding/Level</dct:identifier>
  </skos:ConceptScheme>

  <skos:Concept rdf:about="http://dcat-ap.de/def/politicalGeocoding/Level/international">
