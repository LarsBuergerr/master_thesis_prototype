    <skos:topConceptOf rdf:resource="http://dcat-ap.de/def/politicalGeocoding/Level"/>
    <skos:inScheme rdf:resource="http://dcat-ap.de/def/politicalGeocoding/Level"/>
    <skos:prefLabel xml:lang="de">internationale Ebene</skos:prefLabel>
    <skos-xl:prefLabel>
      <skos-xl:Label>
        <rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
        <skos-xl:literalForm xml:lang="de">internationale Ebene</skos-xl:literalForm>
        <rdfs:label xml:lang="de">internationale Ebene</rdfs:label>
      </skos-xl:Label>
    </skos-xl:prefLabel>
    <skos:exactMatch rdf:resource="http://dcat-ap.de/def/politicalGeocoding/Level/international"/>
  </skos:Concept>
