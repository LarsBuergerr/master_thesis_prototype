  "semantic_assessment": {
    "title_quality": {
      "findings": [
        "Titel 'GWB: Natrium' verwendet die unerklärte Abkürzung 'GWB' (vermutlich Grundwasserkörper) als Hauptkennzeichnung",
        "Kein Orts- oder Zeitbezug im Titel, obwohl es sich um regionale Geodaten (Rheinland-Pfalz) handelt",
