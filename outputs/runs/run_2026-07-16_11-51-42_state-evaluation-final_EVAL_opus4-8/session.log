  "semantic_assessment": {
    "title_quality": {
      "findings": [
        "Titel 'GWB: Natrium' verwendet die unerklärte Abkürzung 'GWB' (vermutlich Grundwasserkörper) als Hauptkennzeichnung",
        "Kein Orts- oder Zeitbezug im Titel, obwohl es sich um regionale Geodaten (Rheinland-Pfalz) handelt",
        "Titel ist sehr knapp und für Laien kaum verständlich"
      ],
      "reasoning": "Der Titel besteht im Wesentlichen aus einer kryptischen Abkürzung plus einem Stoffnamen. Ohne Auflösung von 'GWB' und ohne Orts-/Zeitkontext ist er wenig aussagekräftig und schwer von anderen Datensätzen unterscheidbar.",
      "applicable": true,
      "score": 0.3
    },
    "description_quality": {
      "findings": [
        "Beschreibung 'Darstellung von Natrium' ist extrem knapp und wiederholt praktisch nur den Titelbegriff",
        "Keine Angaben zu Struktur, Format, Erhebungsmethode, Quelle oder Zweck",
        "Kein Bezug zu Grundwasserkörpern, Messverfahren oder räumlicher Abdeckung"
      ],
      "reasoning": "Die Beschreibung beantwortet keine der zentralen Fragen (Was, Wie strukturiert, Wie/warum erhoben, Wozu). Sie ist inhaltsleer und liefert keinen Mehrwert über den Titel hinaus.",
      "applicable": true,
      "score": 0.1
    },
    "title_description_coherence": {
      "findings": [
        "Titel nennt 'Natrium', Beschreibung nennt 'Darstellung von Natrium' - beide beziehen sich auf denselben Stoff",
        "Kein Widerspruch, aber die Beschreibung ergänzt den Titel inhaltlich nicht"
      ],
      "reasoning": "Titel und Beschreibung sind widerspruchsfrei und behandeln dieselbe Sache. Da beide jedoch nahezu identisch minimal sind, ist die Kohärenz zwar gegeben, aber trivial.",
      "applicable": true,
      "score": 0.7
    },
    "keyword_quality": {
      "findings": [
        "Viele fachlich passende Begriffe (Grundwasserkörper, Hydrogeologie, Grundwasserschutz)",
        "Enthält formale/organisatorische Tags wie 'ag_geoinformation', 'lgb', 'geodaten' und den Ortsnamen 'rheinland-pfalz', die in eigene Felder gehören",
        "Komposita und Pluralformen ('flusseinzugsgebiete', 'gewässer', 'grundwasserleiter') statt atomarer Singularbegriffe"
      ],
      "reasoning": "Die Schlagwörter decken das Thema breit ab und sind überwiegend fachlich relevant, enthalten aber formale/redundante Tags sowie Komposita und Pluralformen, was die Qualität mindert. Auffällig fehlt ein Schlagwort zum eigentlichen Inhalt 'Natrium'.",
      "applicable": true,
      "score": 0.5
    },
    "thematic_consistency": {
      "findings": [
        "Themen sind REGI (Regionen) und TECH (Wissenschaft/Technik), Schlagwörter sind hydrogeologisch/wasserbezogen",
        "Ein Umwelt-Thema (ENVI) wäre für Grundwasser/Wasserschutz naheliegender als TECH",
        "Titel, Beschreibung und Schlagwörter zeigen konsistent ein hydrogeologisches Grundwasserthema"
      ],
      "reasoning": "Titel, Beschreibung und Schlagwörter ergeben ein widerspruchsfreies Bild (Grundwasser/Natrium in RLP). Die Themenzuordnung REGI/TECH passt nur eingeschränkt zum klaren Umwelt-/Wasserbezug, ein direkter Widerspruch liegt aber nicht vor.",
      "applicable": true,
      "score": 0.6
    },
    "contextual_qualifiers": {
      "findings": [
        "Es handelt sich um Geodaten mit Zeitbezug (temporal 2021-01-01), ein Bezugszeitraum ist grundsätzlich vorhanden",
        "Räumliche Abdeckung wird nur über Schlagwort 'rheinland-pfalz' angedeutet, spatial-Feld ist leer",
        "Weder im Titel noch in der Beschreibung wird der Bezugszeitraum (2021) genannt"
      ],
      "reasoning": "Als Geodaten mit Zeitreihenbezug wären räumliche Abdeckung und Bezugszeitraum in der beschreibenden Metadatenebene erwartbar. Die Zeitangabe existiert nur im temporal-Feld, die räumliche Abdeckung nur implizit im Schlagwort - in Titel/Beschreibung fehlen diese Qualifizierer, was die Aussagekraft schwächt.",
      "applicable": true,
      "score": 0.4
    },
    "overall_summary": "Die Metadaten behandeln konsistent Natrium in Grundwasserkörpern in Rheinland-Pfalz, sind aber durch einen kryptischen Titel ('GWB'), eine inhaltsleere Beschreibung und fehlende Kontextangaben (Zeitraum, räumliche Abdeckung) insgesamt wenig aussagekräftig. Die Schlagwörter sind fachlich brauchbar, enthalten aber formale und redundante Tags."
