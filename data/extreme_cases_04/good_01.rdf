      >
        <dct:title>Bodenfeuchtesensor - Gewerbegebiet - CSV</dct:title>
        <dct:description
          >Der Bodenfeuchtesensor misst die Bodenfeuchtigkeit in % und
          Bewässerung in mm in 30 cm, 60 cm und 90 cm Tiefe. The soil moisture
          sensor measures soil moisture in % and irrigation in mm at depths of
          30 cm, 60 cm, and 90 cm. The column header is defined as
          MeasurementTypeCode[UnitCode]@levelCm e.g.
          soilTemperatur[CEL]-30;</dct:description
        >
        <dct:license rdf:resource="http://dcat-ap.de/def/licenses/cc-by/4.0" />
