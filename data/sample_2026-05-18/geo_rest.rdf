    <dcat:distribution>
      <dcat:Distribution rdf:about="https://owsproxy.lgl-bw.de/owsproxy/ows/WMS_LGL-BW_ALKIS_VGr_KatGr_E?REQUEST=GetCapabilities&amp;SERVICE=WMS">
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <dct:title>WMS LGL-BW ALKIS Verwaltungs- und Katasterbezirksgrenzen</dct:title>
        <dct:description>ALKIS Verwaltungs- und Katasterbezirksgrenzen Baden-Württemberg aus der NORA-Datenhaltung. Der Dienst liefert die Flurgrenzen, Gemarkungsgrenzen, Gemeindegrenzen, Kreisgrenzen, Regierungsbezirksgrenzen, Regionsgrenzen sowie Landesgrenze als Einzelebenen in den Ausprägungen linienhafte und flächenhafte Darstellung sowie Beschriftung.</dct:description>
