<?xml version="1.0" encoding="utf-8"?>
<!--
  Testfall A — Fehlschlag durch FEHLENDE Angaben.

  Der Datensatz besteht nur aus seiner Typ-Angabe. Jedes Feld, das ein Indikator
  der Dimensionen Auffindbarkeit, Zugänglichkeit und Nachnutzbarkeit prüft, ist
  nicht gesetzt; es gibt insbesondere KEINE einzige dcat:Distribution — daran
  scheitert die gesamte Dimension Zugänglichkeit geschlossen.

  Auch dct:title und dct:description fehlen bewusst. Die DCAT-AP.de-v2.0-Shapes
  erzwingen auf einem dcat:Dataset genau diese beiden Felder und sonst nichts —
  mit gesetztem Titel und gesetzter Beschreibung ist der Datensatz trotz aller
  übrigen Lücken SHACL-konform, und reuse_dcat_ap_de_compliance stünde als
  einziger Indikator auf PASS.

  Aussagekraft (expr_*) ist nicht Gegenstand dieses Testfalls; mit
  abgeschaltetem LLM bleiben diese Indikatoren ohnehin außen vor.

  Gegenstück: fail_wrong_values.rdf — dort ist alles gesetzt, aber falsch.
-->
<rdf:RDF
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <dcat:Dataset rdf:about="https://example.org/testfall/fehlende-angaben"/>
</rdf:RDF>
