      "dct:publisher": {
        "@id": "https://ckan.open.nrw.de/organization/81f54baa-27e6-4efa-be13-b75bf7279c68"
      },
      "dct:title": "Geschwindigkeitskontrollen der Stadt Aachen 2022"
    },
