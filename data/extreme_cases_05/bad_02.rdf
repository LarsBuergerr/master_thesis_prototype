  <dcat:Dataset rdf:about="https://opendata.bonn.de/dataset/projektstatusberichte-konferenzzentrum">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title>Projektstatusberichte Konferenzzentrum</dct:title>
    <dct:description>Mit den öffentlichen Projektstatusberichten berichtet die Verwaltung über den aktuellen Sachstand zum Konferenzzentrum. Wie gewohnt, ist der Bericht in einen öffentlichen sowie einen nichtöffentlichen Teil aufgeteilt.
Die öffentliche Teile sind hier abrufbar.
</dct:description>
